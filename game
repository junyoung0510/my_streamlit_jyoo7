<script>
const events = __EVENTS__;

document.getElementById("count").textContent = events.length + "개";
const list = document.getElementById("eventList");
if (!events.length) {
  list.innerHTML = '<li class="empty">아직 예정된 이벤트가 없어요. 곧 알려 드릴게요!</li>';
}
events.forEach(e => {
  const li = document.createElement("li");
  li.className = "event";
  li.innerHTML = '<div class="stub"><small></small><strong></strong></div><div class="body"><h3></h3><p></p></div>';
  li.querySelector("small").textContent = e.month;
  li.querySelector("strong").textContent = e.day;
  li.querySelector("h3").textContent = e.title;
  const b = document.createElement("span");
  b.className = "badge";
  b.textContent = e.status;
  li.querySelector("h3").appendChild(b);
  li.querySelector("p").textContent = e.desc;
  list.appendChild(li);
});
